{
	"name": "coffee",
	"version": "1.0.0",
	"description": "디스코드 커피챗 매칭 봇",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check",
		"match": "bun run match/index.ts",
		"test": "bun test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "wrangler types && astro check && tsc --project match/tsconfig.json --noEmit",
		"deploy": "bun run build && wrangler deploy",
		"register-commands": "bun run scripts/register-commands.ts"
	},
	"dependencies": {
		"astro": "^7.3.8",
		"@astrojs/cloudflare": "^14.3.4",
		"discord.js": "^14.27.0",
		"discord-api-types": "^0.38.56"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "^1.4.2",
		"typescript": "^6",
		"wrangler": "^4.149.0"
	}
}
