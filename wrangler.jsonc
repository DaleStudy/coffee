{
	"name": "coffee",
	"account_id": "94480614a6df7731f1e4491bdac5c440",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2025-02-03",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "drop-trailing-slash"
	},
	"vars": {
		"DISCORD_PUBLIC_KEY": "48f59590c72e1076554a99adeeb47eb678c87b92202b18cfea1b03ce5dbcbf02",
		"DISCORD_APPLICATION_ID": "1464984307331502092",
		"DISCORD_SERVER_ID": "775115965964222492"
	},
	// PR 미리보기(wrangler preview)는 운영 설정을 상속하지 않으므로 같은 공개 값을 다시 둔다
	"previews": {
		"vars": {
			"DISCORD_PUBLIC_KEY": "48f59590c72e1076554a99adeeb47eb678c87b92202b18cfea1b03ce5dbcbf02",
			"DISCORD_APPLICATION_ID": "1464984307331502092",
			"DISCORD_SERVER_ID": "775115965964222492"
		}
	}
	// DISCORD_BOT_TOKEN은 GitHub secret에서 배포할 때 Worker secret으로 넣는다 (.github/workflows/deploy.yml)
}
